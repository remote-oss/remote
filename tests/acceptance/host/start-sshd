#!/bin/sh
# Installs the run's public key, given in AUTHORIZED_KEY, and the further keys of AUTHORIZED_KEYS_FURTHER (one per line,
# may be empty) for the users harness, harness-nofwd, harness-nosock, harness-noall, harness-mute, harness-ro, harness-i686, harness-fish,
# harness-bash, harness-zsh, harness-dash, harness-ksh, harness-csh and harness-tcsh, writes CA_PUBLIC_KEY (may be empty)
# to /etc/ssh/ca.pub for the certificate-only user harness-cert, sets
# the password HOST_PASSWORD (from the run's env file) for harness-pw and harness-pwonly and forgets it, leaves the host with the download tool
# HOST_FETCH names (busybox-wget, the default; gnu-wget; curl; none), then runs sshd in the foreground.
# The tools are removed with rm: apk del would put BusyBox's wget link back.
set -eu
for account in harness harness-nofwd harness-nosock harness-noall harness-mute harness-ro harness-i686 harness-fish harness-bash harness-zsh harness-dash harness-ksh harness-csh harness-tcsh; do
  install -d -m 700 -o "$account" -g "$account" "/home/$account/.ssh"
  printf '%s\n' "$AUTHORIZED_KEY" "${AUTHORIZED_KEYS_FURTHER:-}" > "/home/$account/.ssh/authorized_keys"
  chown "$account:$account" "/home/$account/.ssh/authorized_keys"
  chmod 600 "/home/$account/.ssh/authorized_keys"
done
printf '%s\n' "${CA_PUBLIC_KEY:-}" > /etc/ssh/ca.pub
chpasswd <<EOF
harness-pw:$HOST_PASSWORD
harness-pwonly:$HOST_PASSWORD
EOF
unset HOST_PASSWORD
case "${HOST_FETCH:-busybox-wget}" in
  busybox-wget) rm -f /usr/bin/curl /usr/bin/wget; ln -s /bin/busybox /usr/bin/wget ;;
  gnu-wget) rm -f /usr/bin/curl ;;
  curl) rm -f /usr/bin/wget ;;
  none) rm -f /usr/bin/wget /usr/bin/curl ;;
  *) echo "unknown HOST_FETCH: ${HOST_FETCH}" >&2; exit 1 ;;
esac
# HOST_SHELL, when given, is the login shell of the user harness; unset leaves the image's /bin/sh.
if [ -n "${HOST_SHELL:-}" ]; then
  usermod -s "$HOST_SHELL" harness
fi
exec /usr/sbin/sshd -D -e
