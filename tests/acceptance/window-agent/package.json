{
  "name": "acceptance-window-agent",
  "displayName": "Acceptance window agent",
  "description": "Runs the commands a test writes for this window and reports its own activation; a test tool that does nothing outside the harness and never goes into a product VSIX.",
  "version": "0.0.0",
  "publisher": "remote-oss",
  "type": "module",
  "private": true,
  "engines": {
    "vscode": "^1.139.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onResolveRemoteAuthority:ssh-remote",
    "onResolveRemoteAuthority:dev-container"
  ],
  "enabledApiProposals": [
    "tunnels"
  ],
  "main": "./extension.cjs"
}
