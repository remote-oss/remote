#!/bin/sh
# Installs the run's public key, given in AUTHORIZED_KEY, and the further keys of AUTHORIZED_KEYS_FURTHER (one per line,
# may be empty) for the user harness, writes CA_PUBLIC_KEY (may be empty) to /etc/ssh/ca.pub, forgets HOST_PASSWORD
# (its user is the Alpine host's only), leaves the host with the download tool HOST_FETCH names (gnu-wget, the
# default; curl; none; BusyBox's wget is the Alpine host's), sets HOST_SHELL as harness's login shell when given, then
# runs sshd in the foreground. It is the Alpine host's start-sshd for the one account this image has.
set -eu
install -d -m 700 -o harness -g harness /home/harness/.ssh
printf '%s\n' "$AUTHORIZED_KEY" "${AUTHORIZED_KEYS_FURTHER:-}" > /home/harness/.ssh/authorized_keys
chown harness:harness /home/harness/.ssh/authorized_keys
chmod 600 /home/harness/.ssh/authorized_keys
printf '%s\n' "${CA_PUBLIC_KEY:-}" > /etc/ssh/ca.pub
unset HOST_PASSWORD
case "${HOST_FETCH:-gnu-wget}" in
  gnu-wget) rm -f /usr/bin/curl ;;
  curl) rm -f /usr/bin/wget ;;
  none) rm -f /usr/bin/wget /usr/bin/curl ;;
  *) echo "HOST_FETCH ${HOST_FETCH} is not on the Ubuntu host (gnu-wget, curl, none)" >&2; exit 1 ;;
esac
if [ -n "${HOST_SHELL:-}" ]; then
  usermod -s "$HOST_SHELL" harness
fi
mkdir -p /run/sshd
exec /usr/sbin/sshd -D -e
