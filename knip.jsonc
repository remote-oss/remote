{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // @vscode/test-cli reads .vscode-test.mjs.
      "entry": ["tools/*.ts", ".vscode-test.mjs"],
      "project": ["tools/**/*.ts", "*.config.ts"],
    },
    // Each package's entry point is the one tools/build.ts bundles; its tests are entries of their own.
    "packages/*": {
      "entry": ["src/extension.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
  },
  // A system tool: preinstalled on the CI runner, installed with Homebrew or the package manager elsewhere.
  "ignoreBinaries": ["shellcheck"],
  "ignoreDependencies": [
    // @vscode/test-cli loads it to download and start the editor.
    "@vscode/test-electron",
    // tools/coverage.ts starts it through import.meta.resolve, which knip does not follow.
    "c8",
  ],
}
