{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      // The scripts package.json runs (tools/check-layout is a shim to check-layout.ts); their exports are
      // checked like any other module's.
      "entry": [
        "tools/check-layout.ts!",
        "tools/build.ts!",
        "tools/coverage.ts!",
        "tools/integration-tests.ts!",
        "tools/licences.ts!",
        "tools/acceptance.ts!",
        "tools/identifiers.ts!",
        "tools/public-surface.ts!",
        "tools/string-tables.ts!",
        "tools/locale-tables.ts!",
        "tools/check-coverage.ts!",
        "tools/seed-coverage.ts!",
        "tools/package-extensions.ts!",
        "tools/package-run.ts!",
        ".vscode-test.mjs!",
      ],
      "project": ["tools/**/*.ts!", "*.config.ts!"],
    },
    // Tests only: no coverage unit; the code is exercised by the acceptance job.
    "tests/acceptance": {
      // The test-cli configuration reads the default export; the suite files are the entries.
      "entry": [
        "vscode-test.mjs",
        "suite/*.test.ts",
        "suite/settle.ts",
        "suite-local/*.test.ts",
        "suite-remote/*.test.ts",
        "suite-reconnect/*.test.ts",
        "suite-forwarding/*.test.ts",
        "suite-failure/*.test.ts",
        "suite-ports/*.test.ts",
        "suite-platform/*.test.ts",
        "suite-install/*.test.ts",
        "suite-terminal/*.test.ts",
        "suite-socket/*.test.ts",
        "suite-client/*.test.ts",
        "suite-slow/*.test.ts",
        "slow-remote/src/extension.ts",
        "windows/*.test.ts",
        "login-shells/*.test.ts",
        "config-files/*.test.ts",
        "no-proposals/*.test.ts",
        "default-ports/*.test.ts",
        "terminal-pick/*.test.ts",
        "preconnect/*.test.ts",
        "explorer/*.test.ts",
        "explorer-alone/*.test.ts",
        "explorer-trust/*.test.ts",
        "explorer-home/*.test.ts",
        "explorer-rows/*.test.ts",
        "explorer-no-proposals/*.test.ts",
        "explorer-standdown/*.test.ts",
        "trust/*.test.ts",
        "trust-terminal/*.test.ts",
        "genuine/*.test.ts",
        "genuine-containers/*.test.ts",
        "ssh-no-proposals/*.test.ts",
        "containers/*.test.ts",
        "containers-standdown/*.test.ts",
        "containers-no-proposals/*.test.ts",
        "containers-trust/*.test.ts",
        "containers-context/*.test.ts",
        "containers-index/*.test.ts",
        "containers-volume/*.test.ts",
        "containers-explorer/*.test.ts",
        "containers-ports/*.test.ts",
        "containers-features/*.test.ts",
        "containers-shutdown/*.test.ts",
        "containers-killed/*.test.ts",
        "containers-view/*.test.ts",
        "containers-podman/*.test.ts",
        "extensionpack/*.test.ts",
        "extensionpack-german/*.test.ts",
        "web-ui/*.test.ts",
        "web-ui-trust/*.test.ts",
        "window-agent/src/extension.ts",
        "server/*.test.ts",
        "containers-cli/*.test.ts",
      ],
      "project": ["**/*.ts", "vscode-test.mjs"],
      "includeEntryExports": false,
    },
    // A library's entry is its index: its exports are the contract the extensions import, so they are not reported
    // as unused; everything behind the index is.
    "packages/lib-*": {
      // Test fixtures run as separate processes.
      "entry": ["src/index.ts!", "test/**/*.test.ts", "test/fixtures/*.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"],
      "includeEntryExports": false,
    },
    // Each package's entry points are the ones tools/build.ts bundles; its tests are entries of their own.
    "packages/*": {
      "entry": [
        "src/extension.ts!",
        "src/web-extension.ts!",
        "src/programs/*.ts!",
        "test/**/*.test.ts",
      ],
      "project": ["src/**/*.ts!", "test/**/*.ts"],
    },
  },
  // A system tool: preinstalled on the CI runner, installed with Homebrew or the package manager elsewhere.
  // @vscode/test-cli reads the default export of its configuration file.
  "ignoreIssues": {
    ".vscode-test.mjs": ["exports"],
    "tests/acceptance/vscode-test.mjs": ["exports"],
    // The editor calls an extension's activate().
    "packages/*/src/extension.ts": ["exports"],
    "packages/*/src/web-extension.ts": ["exports"],
  },
  // System tools the tests run, which no package provides.
  "ignoreBinaries": ["shellcheck", "ssh-add"],
  "ignoreDependencies": [
    // The editor provides it to the acceptance tests at run time; @types/vscode types it.
    "vscode",
    // @vscode/test-cli loads it to download and start the editor.
    "@vscode/test-electron",
    // tools/coverage.ts starts it through import.meta.resolve, which knip does not follow.
    "c8",
    // tools/package-extensions.ts starts it the same way.
    "@vscode/vsce",
    // tools/build.ts copies its files into the VSIX; nothing imports it.
    "@devcontainers/cli",
    // The CLI preload loads the editor's own copy at run time (ADR-0011); the VSIX does not ship it.
    "node-pty",
  ],
}
