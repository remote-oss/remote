{
  "name": "remote",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "typecheck": "pnpm -s identifiers && tsc --build",
    "lint": "pnpm -s identifiers && node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -s identifiers && node tools/build.ts",
    "test:unit": "pnpm -s identifiers && mocha",
    "test:integration": "node tools/integration-tests.ts",
    "check-layout": "pnpm -s identifiers && tools/check-layout",
    "dupes": "jscpd -c .jscpd.json packages tools",
    "dead": "pnpm -s identifiers && knip --no-progress --no-config-hints",
    "coverage": "pnpm -s identifiers && node tools/coverage.ts",
    "coverage:update": "pnpm -s identifiers && node tools/coverage.ts --update",
    "lint:shell": "shellcheck tools/check-layout tools/spec-watch tests/acceptance/host/start-sshd tests/acceptance/host-ubuntu/start-sshd",
    "check-licences": "node tools/licences.ts",
    "identifiers": "node tools/identifiers.ts && node tools/locale-tables.ts",
    "check-identifiers": "node tools/identifiers.ts --check",
    "check-consumed": "pnpm -s identifiers && node tools/identifiers.ts --consumed",
    "check-public-surface": "pnpm -s identifiers && node tools/public-surface.ts",
    "check-string-tables": "node tools/locale-tables.ts && node tools/string-tables.ts",
    "check-coverage": "node tools/check-coverage.ts",
    "check-ci-gate": "node tools/check-ci-gate.ts",
    "check-workflow-tokens": "node tools/check-workflow-tokens.ts",
    "import-suite": "node tools/import-suite.ts",
    "package": "node tools/package-run.ts",
    "acceptance:clean": "node tools/acceptance-run.ts --clean",
    "test:acceptance": "pnpm package && node tools/acceptance.ts",
    "test:acceptance:vscodium": "pnpm package && node tools/acceptance.ts --editor vscodium",
    "test:acceptance:server": "pnpm build && mocha --no-config --extension ts --spec 'tests/acceptance/server/*.test.ts'",
    "test:acceptance:containers-cli": "pnpm build && node tools/package-extensions.ts remote-containers && mocha --no-config --extension ts --spec 'tests/acceptance/containers-cli/*.test.ts'",
    "test:acceptance:variants": "node tools/acceptance-variants.ts",
    "test:acceptance:real-server": "REMOTE_OSS_REAL_SERVER=1 mocha --no-config --extension ts --spec 'tests/acceptance/server/real-server.test.ts'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.1",
    "@types/vscode": "1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "2.26.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-jsdoc": "^65.1.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "jscpd": "^5.4.0",
    "knip": "^6.39.0",
    "mocha": "^11.8.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.0",
    "yaml": "^2.9.1"
  }
}
