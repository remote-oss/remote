{
  "name": "remote",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "typecheck": "node tools/identifiers.ts && tsc --build",
    "lint": "node tools/identifiers.ts && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node tools/identifiers.ts && node tools/build.ts",
    "test:unit": "node tools/identifiers.ts && mocha",
    "test:integration": "node tools/integration-tests.ts",
    "check-layout": "tools/check-layout",
    "dupes": "jscpd -c .jscpd.json packages tools",
    "dead": "node tools/identifiers.ts && knip --no-progress --no-config-hints",
    "coverage": "node tools/identifiers.ts && node tools/coverage.ts",
    "coverage:update": "node tools/identifiers.ts && node tools/coverage.ts --update",
    "lint:shell": "shellcheck tools/check-layout tools/spec-watch tests/acceptance/host/start-sshd",
    "check-licences": "node tools/licences.ts",
    "identifiers": "node tools/identifiers.ts",
    "check-identifiers": "node tools/identifiers.ts --check",
    "check-public-surface": "node tools/public-surface.ts",
    "check-string-tables": "node tools/string-tables.ts",
    "package": "pnpm build && node tools/package-extensions.ts",
    "test:acceptance": "pnpm package && node tools/acceptance.ts",
    "test:acceptance:server": "mocha --no-config --extension ts --spec 'tests/acceptance/server/*.test.ts'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.1",
    "@types/vscode": "~1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "2.26.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-jsdoc": "^65.1.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "jscpd": "^5.4.0",
    "knip": "^6.39.0",
    "mocha": "^11.8.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.0",
    "yaml": "^2.9.1"
  }
}
