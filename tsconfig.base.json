// Product source: packages/<x>/src. Tests have their own projects (tsconfig.base.test.json), so test globals such as
// `describe` do not type-check in product source.
{
  "compilerOptions": {
    "strict": true,
    "target": "es2023",
    "lib": ["es2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    // tsc --build (ADR-0002, decision 4) writes declarations only, and with its build info only into the git-ignored
    // .tsc/ of each package. esbuild writes the JavaScript.
    "composite": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "${configDir}/.tsc",
    "tsBuildInfoFile": "${configDir}/.tsc/src.tsbuildinfo",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  // An empty "files" list lets a package without sources pass; "include" still picks them up once they exist.
  "files": [],
  "include": ["${configDir}/src"]
}
