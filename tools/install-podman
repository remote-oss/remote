#!/usr/bin/env bash
# install-podman: rootless Podman 5 for the containers-podman launch, as the job's own user, on a Linux CI machine.
#
#   tools/install-podman    install Podman when the machine's is older than release 5, set rootless Podman up for the
#                           user, and print what `podman info` reports
#
# A machine whose podman is release 5 or later keeps it. Otherwise (Ubuntu 24.04 has 4.9.3) podman-static's build at
# the version pinned below is checked against its pinned sha256, unpacked and copied into /usr/local and /etc/containers,
# which come first on the PATH and replace the machine's configuration. Its runc is left out: one in /usr/local/bin
# would come before Docker's own. Rootless Podman then needs newuidmap and newgidmap setuid and subordinate ids for the
# user. On Ubuntu, the job lifts the restriction on unprivileged user namespaces first (the workflow's AppArmor step).
# A version change here is the only way the pin moves.
set -euo pipefail

PODMAN_VERSION=6.1.4
PODMAN_SHA256_AMD64=9dd51073fac5a1742f88cf3caff5554615cb4d67ba554d25e8807be635547af5
PODMAN_SHA256_ARM64=816bc5b97dc62396838d825aaccd9d3eb841167a2d31968efc1e6a3e6a0a463b
CONMON_VERSION=2.2.1
CONMON_SHA256_AMD64=1d97294c14c43d477e0a0826e9cd0f2a2af373ddfafe6f10252e8a3c43f32be6
CONMON_SHA256_ARM64=c2fa62b3555eb0a729d853df23c5784d970f46050f2fb5f9931ded1bf455d216

# the major release of the podman on the PATH, or nothing when there is none
podman_major() {
  podman --version 2>/dev/null | sed -n 's/^podman version \([0-9][0-9]*\)\..*/\1/p'
}

major=$(podman_major)
if [ -z "$major" ] || [ "$major" -lt 5 ]; then
  case "$(uname -m)" in
    x86_64) arch=amd64 sha256=$PODMAN_SHA256_AMD64 conmon_sha256=$CONMON_SHA256_AMD64 ;;
    aarch64 | arm64) arch=arm64 sha256=$PODMAN_SHA256_ARM64 conmon_sha256=$CONMON_SHA256_ARM64 ;;
    *)
      echo "install-podman: no pinned Podman for $(uname -m)" >&2
      exit 1
      ;;
  esac
  work=$(mktemp -d)
  trap 'rm -rf "$work"' EXIT
  archive="$work/podman-linux-$arch.tar.gz"
  curl -fsSL -o "$archive" \
    "https://github.com/mgoltzsche/podman-static/releases/download/v$PODMAN_VERSION/podman-linux-$arch.tar.gz"
  echo "$sha256  $archive" | sha256sum -c - >/dev/null
  tar -xzf "$archive" -C "$work"
  rm -f "$work/podman-linux-$arch/usr/local/bin/runc"
  sudo cp -r "$work/podman-linux-$arch/usr" "$work/podman-linux-$arch/etc" /
  hash -r
  # podman looks for crun in /usr/bin first, where the machine's older crun refuses the OCI version of this Podman's
  # container specification ("unknown version specified"): the crun that came with it, which this script has just put
  # in /usr/local/bin, is named instead
  sudo mkdir -p /etc/containers/containers.conf.d
  printf '[engine.runtimes]\ncrun = ["/usr/local/bin/crun"]\n' |
    sudo tee /etc/containers/containers.conf.d/10-crun.conf >/dev/null
  major=$(podman_major)
  [ "${major:-0}" -ge 5 ] || {
    echo "install-podman: the podman on the PATH is still $(podman --version 2>&1)" >&2
    exit 1
  }
fi

command -v newuidmap >/dev/null || {
  echo "install-podman: newuidmap is needed and not installed (the uidmap or shadow-utils package)" >&2
  exit 1
}
sudo chmod u+s "$(command -v newuidmap)" "$(command -v newgidmap)"
grep -q "^$(id -un):" /etc/subuid ||
  sudo usermod --add-subuids 200000-265535 --add-subgids 200000-265535 "$(id -un)"
podman --version
# a machine restarted since podman last ran keeps a run folder podman refuses ("boot ID differs from cached boot ID"):
# the two folders that error names are removed, and only for that error
if ! out=$(podman info --format '{{.Host.Security.Rootless}} {{.Store.GraphDriverName}}' 2>&1); then
  printf '%s\n' "$out"
  printf '%s' "$out" | grep -q 'boot ID differs from cached boot ID' || exit 1
  rm -rf "/tmp/storage-run-$(id -u)/containers" "/tmp/storage-run-$(id -u)/libpod/tmp"
fi
podman info --format '{{.Host.Security.Rootless}} {{.Store.GraphDriverName}}'
podman info --format '{{.Host.OCIRuntime.Path}}'
# debug (hosted only): where does an exec of this podman wait
set +e
podman run -d --name dbg docker.io/library/alpine:3.20 sleep 600
podman --version; podman info --format '{{.Host.Conmon.Path}} {{.Host.Conmon.Version}}'
for each in 1 2 3; do timeout 15 podman exec dbg true; echo "true $each rc=$?"; done
printf hi | timeout 15 podman exec -i dbg cat; echo "cat rc=$?"
echo "--- cleanup"; podman rm -f dbg
set -e
exit 1 # debug (hosted only): end the job here, so that the probe's lines can be read
