#!/usr/bin/env bash
# install-podman: rootless Podman at the release pinned below for the containers-podman launch, as the job's own user,
# on a Linux CI machine.
#
#   tools/install-podman    install the pinned Podman unless the machine's is that release, set rootless Podman up for
#                           the user, and print what `podman info` reports
#
# A machine whose podman is the pinned release keeps it. Otherwise (Ubuntu 24.04 has 4.9.3) podman-static's build at the
# pinned version is checked against its pinned sha256, unpacked and copied into /usr/local and /etc/containers, which
# come first on the PATH and replace the machine's configuration. The pin is 6.1.4: on GitHub's ubuntu-24.04 (kernel
# 7.0.0-1017-azure) `podman exec` of a command that ends at once never returns with 5.7.1 or 5.8.8, whatever their
# conmon, and returns with 6.1.4 (runs 41990219734, 41969557740). Its runc is left out: one in /usr/local/bin
# would come before Docker's own. Rootless Podman then needs newuidmap and newgidmap setuid and subordinate ids for the
# user. On Ubuntu, the job lifts the restriction on unprivileged user namespaces first (the workflow's AppArmor step).
# A version change here is the only way the pin moves.
set -euo pipefail

PODMAN_VERSION=6.1.4
PODMAN_SHA256_AMD64=9dd51073fac5a1742f88cf3caff5554615cb4d67ba554d25e8807be635547af5
PODMAN_SHA256_ARM64=c106d09d7524209ce01eb3a02a7e621e9c55ec31d0fada48439cf77aa07afdb6

# the release of the podman on the PATH, or nothing when there is none
podman_release() {
  podman --version 2>/dev/null | sed -n 's/^podman version \([0-9][0-9.]*\).*/\1/p'
}

if [ "$(podman_release)" != "$PODMAN_VERSION" ]; then
  case "$(uname -m)" in
    x86_64) arch=amd64 sha256=$PODMAN_SHA256_AMD64 ;;
    aarch64 | arm64) arch=arm64 sha256=$PODMAN_SHA256_ARM64 ;;
    *)
      echo "install-podman: no pinned Podman for $(uname -m)" >&2
      exit 1
      ;;
  esac
  work=$(mktemp -d)
  trap 'rm -rf "$work"' EXIT
  archive="$work/podman-linux-$arch.tar.gz"
  curl -fsSL -o "$archive" \
    "https://github.com/mgoltzsche/podman-static/releases/download/v$PODMAN_VERSION/podman-linux-$arch.tar.gz"
  echo "$sha256  $archive" | sha256sum -c - >/dev/null
  tar -xzf "$archive" -C "$work"
  rm -f "$work/podman-linux-$arch/usr/local/bin/runc"
  sudo cp -r "$work/podman-linux-$arch/usr" "$work/podman-linux-$arch/etc" /
  # the archive's crun, not the machine's: Ubuntu 24.04's /usr/bin/crun, which podman finds first, refuses the runtime
  # spec Podman 6 writes ("crun: unknown version specified")
  sudo mkdir -p /etc/containers/containers.conf.d
  printf '[engine.runtimes]\ncrun = ["/usr/local/bin/crun"]\n' |
    sudo tee /etc/containers/containers.conf.d/50-install-podman-crun.conf >/dev/null
  hash -r
  [ "$(podman_release)" = "$PODMAN_VERSION" ] || {
    echo "install-podman: the podman on the PATH is $(podman --version 2>&1), not $PODMAN_VERSION" >&2
    exit 1
  }
fi

command -v newuidmap >/dev/null || {
  echo "install-podman: newuidmap is needed and not installed (the uidmap or shadow-utils package)" >&2
  exit 1
}
sudo chmod u+s "$(command -v newuidmap)" "$(command -v newgidmap)"
grep -q "^$(id -un):" /etc/subuid ||
  sudo usermod --add-subuids 200000-265535 --add-subgids 200000-265535 "$(id -un)"
podman --version
# a machine restarted since podman last ran keeps a run folder podman refuses ("boot ID differs from cached boot ID"):
# the two folders that error names are removed, and only for that error
if ! out=$(podman info --format '{{.Host.Security.Rootless}} {{.Store.GraphDriverName}}' 2>&1); then
  printf '%s\n' "$out"
  printf '%s' "$out" | grep -q 'boot ID differs from cached boot ID' || exit 1
  rm -rf "/tmp/storage-run-$(id -u)/containers" "/tmp/storage-run-$(id -u)/libpod/tmp"
fi
podman info --format '{{.Host.Security.Rootless}} {{.Store.GraphDriverName}} {{.Host.OCIRuntime.Path}}'
runtime=$(podman info --format '{{.Host.OCIRuntime.Path}}')
[ "$runtime" = /usr/local/bin/crun ] || {
  echo "install-podman: Podman $PODMAN_VERSION runs $runtime, not the archive's /usr/local/bin/crun" >&2
  exit 1
}
