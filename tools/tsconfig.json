{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Tools run on Node directly (type stripping), so they resolve modules the way Node does.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // The ESLint config at the root is checked with the tools.
    "rootDir": "..",
    "types": ["node", "mocha"]
  },
  "include": [
    "**/*.ts",
    "../eslint.config.ts",
    "../prettier.config.ts",
    "../tests/acceptance/window-agent/src/window-name.ts",
    "../tests/acceptance/window-agent/src/terminal-selection.ts",
    "../tests/acceptance/windows/agent-events.ts",
    "../tests/acceptance/windows/agent-standing.ts",
    "../tests/acceptance/windows/change-timeline.ts",
    "../tests/acceptance/windows/connect-failure.ts",
    "../tests/acceptance/windows/labels-wait.ts",
    "../tests/acceptance/windows/contribution-polling.ts",
    "../tests/acceptance/windows/corrupt-archive.ts",
    "../tests/acceptance/windows/page-protocol.ts",
    "../tests/acceptance/windows/command-text.ts",
    "../tests/acceptance/windows/editor-folder.ts",
    "../tests/acceptance/windows/foreign-archive.ts",
    "../tests/acceptance/windows/platform-forms.ts",
    "../tests/acceptance/windows/image-pull.ts",
    "../tests/acceptance/windows/late-pickup.ts",
    "../tests/acceptance/windows/page-list.ts",
    "../tests/acceptance/windows/quick-pick-reads.ts",
    "../tests/acceptance/windows/reconnection-state.ts",
    "../tests/acceptance/windows/stored-history.ts"
  ],
  "exclude": ["**/fixtures"]
}
