#!/usr/bin/env bash
# start-display: the display the acceptance launches run on, :99 at 1920x1080x24 with openbox as its window manager.
#
#   tools/start-display    start that display when :99 has none, and name it in $GITHUB_ENV when that is set
#
# A machine whose :99 is already served keeps it. Otherwise Xvfb and then openbox start in the background, each
# installed with apt-get when it is missing; both keep running until the job's processes are ended. xdotool, which the
# row that answers the operating system's own folder chooser types with, is installed when it is missing on either
# kind of machine. Without a window
# manager no window takes the focus, and the rows that type into a dialog, a menu or a picker are written against a
# focused window.
set -euo pipefail

DISPLAY_NAME=:99
SOCKET=/tmp/.X11-unix/X99
LOGS=${RUNNER_TEMP:-/tmp}

missing=()
if [ ! -S "$SOCKET" ]; then
  command -v Xvfb >/dev/null || missing+=(xvfb)
  command -v openbox >/dev/null || missing+=(openbox)
fi
# The key driver is wanted on a machine whose display already runs as well.
command -v xdotool >/dev/null || missing+=(xdotool)
# How long one apt-get call may run: the five minutes it may wait for the dpkg lock, and two more for its work.
APT_CALL_SECONDS=420
# How long the whole step may run, over every call of both attempts: four calls each ended at their own limit would
# otherwise hold the job about 28 minutes.
APT_BUDGET_SECONDS=720
APT_STARTED=0
APT_CALLS=0
APT_ENDED=0

# Runs one call as root, apt-get or dpkg, its output kept in a log of its own, $LOGS/apt-<n>.log (pipefail gives the
# pipe the call's own status). A call that hasn't returned after APT_CALL_SECONDS, or when the step's budget runs out,
# is ended: a fetch that never returns would otherwise hold the job to its limit (#2832). A call that fails or is ended
# prints how long it ran and its log's last lines, which name the package or mirror it stopped at; one that is ended
# sets APT_ENDED. No call starts once the budget is used.
root_call() {
  local started=$SECONDS limit status log
  limit=$((APT_BUDGET_SECONDS - (SECONDS - APT_STARTED)))
  if [ "$limit" -le 0 ]; then
    echo "start-display: $1 $2 was not run: the apt step used its $APT_BUDGET_SECONDS s budget" >&2
    return 1
  fi
  [ "$limit" -le "$APT_CALL_SECONDS" ] || limit=$APT_CALL_SECONDS
  APT_CALLS=$((APT_CALLS + 1))
  log=$LOGS/apt-$APT_CALLS.log
  if sudo DEBIAN_FRONTEND=noninteractive timeout --kill-after=15 "$limit" "$@" 2>&1 | tee "$log" >/dev/null; then
    return 0
  else
    status=$?
  fi
  if [ "$status" = 124 ] || [ "$status" = 137 ]; then
    APT_ENDED=1
    echo "start-display: $1 $2 was ended after $((SECONDS - started)) s, at its limit of $limit s; its last lines:" >&2
  else
    echo "start-display: $1 $2 failed (exit $status) after $((SECONDS - started)) s; its last lines:" >&2
  fi
  tail -n 15 "$log" >&2
  return 1
}

# Runs one apt-get call, $1 being its command: it waits up to five minutes for the dpkg lock and tries each download
# three times.
apt_call() {
  root_call apt-get "$1" -o DPkg::Lock::Timeout=300 -o Acquire::Retries=3 -o Dpkg::Use-Pty=0 "${@:2}"
}

# Installs the packages named, updating the lists first. A fresh hosted runner's unattended-upgrades holds the dpkg lock
# at boot, so each call waits for it, up to five minutes. Each download is tried three times, and an update or install
# that still fails, or is ended, is tried once more from a fresh update 15 s later: an archive that answers 503 for a
# moment, or a mirror caught mid-sync whose lists name no package, fails no job (#2832). A call ended while dpkg was
# unpacking leaves dpkg interrupted, and apt-get refuses to install until it is configured, so the second attempt
# starts with `dpkg --configure -a` when a call of the first was ended. The step stops, named, when its budget is used.
# When both attempts fail, the packages' candidates and the sources are printed, so the failure names which it was.
apt_install() {
  local attempt
  APT_STARTED=$SECONDS
  for attempt in 1 2; do
    if [ "$attempt" = 2 ] && [ "$APT_ENDED" = 1 ]; then
      root_call dpkg --configure -a || true
    fi
    if apt_call update && apt_call install -y "$@"; then
      echo "start-display: installed $* in $((SECONDS - APT_STARTED)) s"
      return 0
    fi
    echo "start-display: installing $* failed (attempt $attempt of 2)" >&2
    [ "$attempt" = 1 ] || break
    if [ $((SECONDS - APT_STARTED + 15)) -ge "$APT_BUDGET_SECONDS" ]; then
      echo "start-display: the apt step has used $((SECONDS - APT_STARTED)) s of its $APT_BUDGET_SECONDS s budget, so there is no second attempt" >&2
      break
    fi
    sleep 15
  done
  echo "start-display: could not install $*; their candidates and the sources:" >&2
  apt-cache policy "$@" >&2 || true
  grep -hE '^(deb|Types|URIs|Suites|Components)' /etc/apt/sources.list /etc/apt/sources.list.d/* >&2 2>/dev/null || true
  return 1
}

if [ "${#missing[@]}" -gt 0 ]; then
  echo "start-display: installing ${missing[*]}"
  apt_install "${missing[@]}"
fi

if [ ! -S "$SOCKET" ]; then
  nohup Xvfb "$DISPLAY_NAME" -screen 0 1920x1080x24 -nolisten tcp >"$LOGS/xvfb.log" 2>&1 &
  for _ in $(seq 1 100); do
    [ ! -S "$SOCKET" ] || break
    sleep 0.1
  done
  [ -S "$SOCKET" ] || {
    echo "start-display: Xvfb did not start" >&2
    cat "$LOGS/xvfb.log" >&2
    exit 1
  }
  DISPLAY=$DISPLAY_NAME nohup openbox >"$LOGS/openbox.log" 2>&1 &
  sleep 1
  pgrep -x openbox >/dev/null || {
    echo "start-display: openbox did not start" >&2
    cat "$LOGS/openbox.log" >&2
    exit 1
  }
fi
echo "start-display: $DISPLAY_NAME"
[ -z "${GITHUB_ENV:-}" ] || echo "DISPLAY=$DISPLAY_NAME" >>"$GITHUB_ENV"
