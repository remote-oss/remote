#!/usr/bin/env bash
# start-display: the display the acceptance launches run on, :99 at 1920x1080x24 with openbox as its window manager.
#
#   tools/start-display    start that display when :99 has none, and name it in $GITHUB_ENV when that is set
#
# A machine whose :99 is already served keeps it. Otherwise Xvfb and then openbox start in the background, each
# installed with apt-get when it is missing; both keep running until the job's processes are ended. xdotool, which the
# row that answers the operating system's own folder chooser types with, is installed when it is missing on either
# kind of machine. Without a window
# manager no window takes the focus, and the rows that type into a dialog, a menu or a picker are written against a
# focused window.
set -euo pipefail

DISPLAY_NAME=:99
SOCKET=/tmp/.X11-unix/X99
LOGS=${RUNNER_TEMP:-/tmp}

missing=()
if [ ! -S "$SOCKET" ]; then
  command -v Xvfb >/dev/null || missing+=(xvfb)
  command -v openbox >/dev/null || missing+=(openbox)
fi
# The key driver is wanted on a machine whose display already runs as well.
command -v xdotool >/dev/null || missing+=(xdotool)
# How long one apt-get call may run: the five minutes it may wait for the dpkg lock, and two more for its work.
APT_CALL_SECONDS=420
APT_LOG=$LOGS/apt.log

# Runs one apt-get call as root, its output kept in $APT_LOG (pipefail gives the pipe the call's own status). A call that hasn't returned after APT_CALL_SECONDS is
# ended: a fetch that never returns would otherwise hold the job to its limit (#2832). A call that fails or is ended
# prints how long it ran and the log's last lines, which name the package or mirror it stopped at.
apt_call() {
  local started=$SECONDS status
  if sudo DEBIAN_FRONTEND=noninteractive timeout --kill-after=15 "$APT_CALL_SECONDS" \
    apt-get -o DPkg::Lock::Timeout=300 -o Acquire::Retries=3 -o Dpkg::Use-Pty=0 "$@" 2>&1 | tee -a "$APT_LOG" >/dev/null; then
    return 0
  else
    status=$?
  fi
  if [ "$status" = 124 ] || [ "$status" = 137 ]; then
    echo "start-display: apt-get $1 was ended after $((SECONDS - started)) s; its last lines:" >&2
  else
    echo "start-display: apt-get $1 failed (exit $status) after $((SECONDS - started)) s; its last lines:" >&2
  fi
  tail -n 15 "$APT_LOG" >&2
  return 1
}

# Installs the packages named, updating the lists first. A fresh hosted runner's unattended-upgrades holds the dpkg lock
# at boot, so each call waits for it, up to five minutes. Each download is tried three times, and an update or install
# that still fails, or is ended, is tried once more from a fresh update 15 s later: an archive that answers 503 for a
# moment, or a mirror caught mid-sync whose lists name no package, fails no job (#2832). When both fail, the packages'
# candidates and the sources are printed, so the failure names which it was.
apt_install() {
  local attempt started=$SECONDS
  for attempt in 1 2; do
    if apt_call update && apt_call install -y "$@"; then
      echo "start-display: installed $* in $((SECONDS - started)) s"
      return 0
    fi
    echo "start-display: installing $* failed (attempt $attempt of 2)" >&2
    [ "$attempt" = 2 ] || sleep 15
  done
  echo "start-display: could not install $*; their candidates and the sources:" >&2
  apt-cache policy "$@" >&2 || true
  grep -hE '^(deb|Types|URIs|Suites|Components)' /etc/apt/sources.list /etc/apt/sources.list.d/* >&2 2>/dev/null || true
  return 1
}

if [ "${#missing[@]}" -gt 0 ]; then
  echo "start-display: installing ${missing[*]}"
  apt_install "${missing[@]}"
fi

if [ ! -S "$SOCKET" ]; then
  nohup Xvfb "$DISPLAY_NAME" -screen 0 1920x1080x24 -nolisten tcp >"$LOGS/xvfb.log" 2>&1 &
  for _ in $(seq 1 100); do
    [ ! -S "$SOCKET" ] || break
    sleep 0.1
  done
  [ -S "$SOCKET" ] || {
    echo "start-display: Xvfb did not start" >&2
    cat "$LOGS/xvfb.log" >&2
    exit 1
  }
  DISPLAY=$DISPLAY_NAME nohup openbox >"$LOGS/openbox.log" 2>&1 &
  sleep 1
  pgrep -x openbox >/dev/null || {
    echo "start-display: openbox did not start" >&2
    cat "$LOGS/openbox.log" >&2
    exit 1
  }
fi
echo "start-display: $DISPLAY_NAME"
[ -z "${GITHUB_ENV:-}" ] || echo "DISPLAY=$DISPLAY_NAME" >>"$GITHUB_ENV"
