#!/usr/bin/env bash
# start-display: the display the acceptance launches run on, :99 at 1920x1080x24 with openbox as its window manager.
#
#   tools/start-display    start that display when :99 has none, and name it in $GITHUB_ENV when that is set
#
# A machine whose :99 is already served keeps it. Otherwise Xvfb and then openbox start in the background, each
# installed with apt-get when it is missing; both keep running until the job's processes are ended. xdotool, which the
# row that answers the operating system's own folder chooser types with, and xprop, which tells the key driver whether a
# window is a frame the window manager manages, are installed when they are missing on either kind of machine. Without a window
# manager no window takes the focus, and the rows that type into a dialog, a menu or a picker are written against a
# focused window.
set -euo pipefail

DISPLAY_NAME=:99
# The display's socket, where apt keeps its sources and where the release is named; the rows of
# tools/start-display.test.ts point them elsewhere.
SOCKET=${START_DISPLAY_SOCKET:-/tmp/.X11-unix/X99}
APT_SOURCES=${START_DISPLAY_APT_SOURCES:-/etc/apt}
OS_RELEASE=${START_DISPLAY_OS_RELEASE:-/etc/os-release}
LOGS=${RUNNER_TEMP:-/tmp}

missing=()
if [ ! -S "$SOCKET" ]; then
  command -v Xvfb >/dev/null || missing+=(xvfb)
  command -v openbox >/dev/null || missing+=(openbox)
fi
# The key driver is wanted on a machine whose display already runs as well.
command -v xdotool >/dev/null || missing+=(xdotool)
# The WM_STATE read of the key driver's window picks, in x11-utils.
command -v xprop >/dev/null || missing+=(x11-utils)
# The _NET_CLOSE_WINDOW of the leftover windows the display closes, in wmctrl.
command -v wmctrl >/dev/null || missing+=(wmctrl)
# How long one apt-get call may run: the five minutes it may wait for the dpkg lock, and two more for its work.
APT_CALL_SECONDS=420
# How long the whole step may run, over every call of the three attempts: six calls each ended at their own limit would
# otherwise hold the job about 42 minutes.
APT_BUDGET_SECONDS=960
# The pauses before the second and the third attempt, in seconds: the last comes after the sources have failed for
# about three minutes, as the VSCodium downloads' last wait does.
APT_PAUSES=(15 180)
APT_STARTED=0
APT_CALLS=0
APT_ENDED=0
# The options that point every apt call at the sources `isolated_sources` gathers.
APT_SOURCE_OPTIONS=()

# Runs one call as root, apt-get or dpkg, its output kept in a log of its own, $LOGS/apt-<n>.log (pipefail gives the
# pipe the call's own status). A call that hasn't returned after APT_CALL_SECONDS, or when the step's budget runs out,
# is ended: a fetch that never returns would otherwise hold the job to its limit (#2832). A call that fails or is ended
# prints how long it ran and its log's last lines, which name the package or mirror it stopped at; one that is ended
# sets APT_ENDED. No call starts once the budget is used.
root_call() {
  local started=$SECONDS limit status log
  limit=$((APT_BUDGET_SECONDS - (SECONDS - APT_STARTED)))
  if [ "$limit" -le 0 ]; then
    echo "start-display: $1 $2 was not run: the apt step used its $APT_BUDGET_SECONDS s budget" >&2
    return 1
  fi
  [ "$limit" -le "$APT_CALL_SECONDS" ] || limit=$APT_CALL_SECONDS
  APT_CALLS=$((APT_CALLS + 1))
  log=$LOGS/apt-$APT_CALLS.log
  if sudo DEBIAN_FRONTEND=noninteractive timeout --kill-after=15 "$limit" "$@" 2>&1 | tee "$log" >/dev/null; then
    return 0
  else
    status=$?
  fi
  if [ "$status" = 124 ] || [ "$status" = 137 ]; then
    APT_ENDED=1
    echo "start-display: $1 $2 was ended after $((SECONDS - started)) s, at its limit of $limit s; its last lines:" >&2
  else
    echo "start-display: $1 $2 failed (exit $status) after $((SECONDS - started)) s; its last lines:" >&2
  fi
  tail -n 15 "$log" >&2
  return 1
}

# Runs one apt-get call, $1 being its command: it waits up to five minutes for the dpkg lock and tries each download
# three times.
apt_call() {
  root_call apt-get "$1" -o DPkg::Lock::Timeout=300 -o Acquire::Retries=3 -o Dpkg::Use-Pty=0 "${APT_SOURCE_OPTIONS[@]}" "${@:2}"
}

# Installs the packages named, updating the lists first. A fresh hosted runner's unattended-upgrades holds the dpkg lock
# at boot, so each call waits for it, up to five minutes. Each download is tried three times, and an update or install
# that still fails, or is ended, is tried again from a fresh update after each pause of APT_PAUSES: an archive that
# answers 503 for a moment, or a mirror caught mid-sync whose lists name no package, fails no job (#2832). A call ended
# while dpkg was unpacking leaves dpkg interrupted, and apt-get refuses to install until it is configured, so a later
# attempt starts with `dpkg --configure -a` when an earlier call was ended. The step stops, named, when its budget is
# used. When every attempt fails, the packages' candidates and the sources are printed, so the failure names which it
# was.
apt_install() {
  local attempt attempts=$((${#APT_PAUSES[@]} + 1)) pause
  APT_STARTED=$SECONDS
  for ((attempt = 1; attempt <= attempts; attempt++)); do
    if [ "$attempt" -gt 1 ] && [ "$APT_ENDED" = 1 ]; then
      root_call dpkg --configure -a || true
    fi
    if apt_call update && apt_call install -y "$@"; then
      echo "start-display: installed $* in $((SECONDS - APT_STARTED)) s"
      return 0
    fi
    echo "start-display: installing $* failed (attempt $attempt of $attempts)" >&2
    [ "$attempt" -lt "$attempts" ] || break
    pause=${APT_PAUSES[$((attempt - 1))]}
    if [ $((SECONDS - APT_STARTED + pause)) -ge "$APT_BUDGET_SECONDS" ]; then
      echo "start-display: the apt step has used $((SECONDS - APT_STARTED)) s of its $APT_BUDGET_SECONDS s budget, so there is no attempt $((attempt + 1))" >&2
      break
    fi
    sleep "$pause"
  done
  echo "start-display: could not install $*; their candidates and the sources:" >&2
  sudo apt-cache "${APT_SOURCE_OPTIONS[@]}" policy "$@" >&2 || true
  grep -hE '^(deb|Types|URIs|Suites|Components)' "$APT_SOURCES/sources.list" "$APT_SOURCES"/sources.list.d/* >&2 2>/dev/null || true
  return 1
}

# Whether the apt source text $1 names an Ubuntu archive: by its address, or through a `mirror+file:` list that names
# one, as a hosted image's ubuntu.sources does (`mirror+file:/etc/apt/apt-mirrors.txt`).
names_ubuntu_archive() {
  local mirrors=() mirror
  [[ ! $1 =~ (archive|security|ports)\.ubuntu\.com ]] || return 0
  # sed, not a match in a pipe, so that a text with no mirror list is no error under pipefail
  mapfile -t mirrors < <(printf '%s\n' "$1" | sed -n 's/.*mirror+file:\([^[:space:]]*\).*/\1/p')
  for mirror in "${mirrors[@]}"; do
    [[ ! "$(cat "$mirror" 2>/dev/null || true)" =~ (archive|security|ports)\.ubuntu\.com ]] || return 0
  done
  return 1
}

# Gathers the apt sources the install reads into a folder of their own, $LOGS/start-display-apt, and points every apt
# call at it. apt keeps its own lists folder, where a mirror list's state lives too; its update then keeps the lists of
# these sources alone, and no later step of a job that starts the display runs apt. The folder holds:
# - only the runner's Ubuntu archive sources, so that a repository the display needs nothing from can't fail the update
#   (the image's packages.microsoft.com answered 403 in release train 110's gate 45901344169);
# - an image's Ubuntu mirror list counts as an Ubuntu source: read as none, the standard sources were written beside it,
#   and in the archive's outage of 2026-11-26 10:11-10:43Z the update waited on them alone (#3235);
# - with no Ubuntu source at all (an image with packages.microsoft.com alone, main's push run 44886359098), the
#   standard sources of the runner's release are written there, since no update would find the packages (#2832).
# A machine that is not Ubuntu keeps its own sources.
isolated_sources() {
  local release codename archive folder=$LOGS/start-display-apt file found=0
  release=$(cat "$OS_RELEASE" 2>/dev/null || true)
  [ -n "$(printf '%s\n' "$release" | sed -n 's/^ID=ubuntu$/yes/p')" ] || return 0
  mkdir -p "$folder/sources.list.d"
  rm -f "$folder"/sources.list.d/*
  : >"$folder/sources.list"
  for file in "$APT_SOURCES/sources.list" "$APT_SOURCES"/sources.list.d/*.list "$APT_SOURCES"/sources.list.d/*.sources; do
    [ -f "$file" ] || continue
    names_ubuntu_archive "$(cat "$file")" || continue
    # sources.list keeps its one-line form under a .list name, which apt reads from the folder as well
    cp "$file" "$folder/sources.list.d/$(basename "$file")"
    found=1
  done
  if [ "$found" = 0 ]; then
    codename=$(printf '%s\n' "$release" | sed -n 's/^VERSION_CODENAME=//p' | tr -d '"')
    [ -n "$codename" ] || return 0
    case "$(dpkg --print-architecture 2>/dev/null)" in
      amd64 | i386) archive=http://archive.ubuntu.com/ubuntu/ ;;
      *) archive=http://ports.ubuntu.com/ubuntu-ports/ ;;
    esac
    echo "start-display: no apt source names an Ubuntu archive; the install reads the standard sources of $codename from $archive" >&2
    printf '%s\n' \
      'Types: deb' \
      "URIs: $archive" \
      "Suites: $codename $codename-updates $codename-security" \
      'Components: main universe restricted multiverse' \
      'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' >"$folder/sources.list.d/start-display-ubuntu.sources"
  fi
  echo "start-display: the install reads $(cd "$folder/sources.list.d" && echo *)"
  APT_SOURCE_OPTIONS=(
    -o "Dir::Etc::sourcelist=$folder/sources.list"
    -o "Dir::Etc::sourceparts=$folder/sources.list.d"
  )
}

if [ "${#missing[@]}" -gt 0 ]; then
  echo "start-display: installing ${missing[*]}"
  isolated_sources
  apt_install "${missing[@]}"
fi

if [ ! -S "$SOCKET" ]; then
  nohup Xvfb "$DISPLAY_NAME" -screen 0 1920x1080x24 -nolisten tcp >"$LOGS/xvfb.log" 2>&1 &
  for _ in $(seq 1 100); do
    [ ! -S "$SOCKET" ] || break
    sleep 0.1
  done
  [ -S "$SOCKET" ] || {
    echo "start-display: Xvfb did not start" >&2
    cat "$LOGS/xvfb.log" >&2
    exit 1
  }
  DISPLAY=$DISPLAY_NAME nohup openbox >"$LOGS/openbox.log" 2>&1 &
  sleep 1
  pgrep -x openbox >/dev/null || {
    echo "start-display: openbox did not start" >&2
    cat "$LOGS/openbox.log" >&2
    exit 1
  }
fi
echo "start-display: $DISPLAY_NAME"
[ -z "${GITHUB_ENV:-}" ] || echo "DISPLAY=$DISPLAY_NAME" >>"$GITHUB_ENV"
