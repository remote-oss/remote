{
  "name": "remote-containers",
  "displayName": "Dev Containers",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "remote-oss",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/remote-oss/remote.git",
    "directory": "packages/remote-containers"
  },
  "bugs": {
    "url": "https://github.com/remote-oss/remote/issues"
  },
  "engines": {
    "vscode": "^1.139.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "keywords": [
    "remote development",
    "remote",
    "containers",
    "docker",
    "devcontainer"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%"
    }
  },
  "activationEvents": [
    "onResolveRemoteAuthority:dev-container"
  ],
  "enabledApiProposals": [
    "resolvers",
    "tunnels",
    "workspaceTrust",
    "terminalDimensions",
    "contribEditSessions",
    "contribViewsRemote",
    "contribRemoteHelp"
  ],
  "l10n": "./l10n",
  "dependencies": {
    "lib-authority": "workspace:*",
    "lib-forwarding": "workspace:*",
    "lib-host": "workspace:*",
    "lib-identifiers": "workspace:*",
    "lib-log": "workspace:*",
    "lib-product": "workspace:*",
    "lib-standdown": "workspace:*"
  }
}
