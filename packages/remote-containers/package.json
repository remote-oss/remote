{
  "name": "remote-containers",
  "displayName": "Dev Containers",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "remote-oss",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/remote-oss/remote.git",
    "directory": "packages/remote-containers"
  },
  "bugs": {
    "url": "https://github.com/remote-oss/remote/issues"
  },
  "engines": {
    "vscode": "^1.139.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "keywords": [
    "remote development",
    "remote",
    "containers",
    "docker",
    "devcontainer"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%"
    }
  },
  "activationEvents": [
    "onResolveRemoteAuthority:dev-container"
  ],
  "enabledApiProposals": [
    "resolvers",
    "tunnels",
    "workspaceTrust",
    "terminalDimensions",
    "contribEditSessions",
    "contribViewsRemote",
    "contribRemoteHelp"
  ],
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "remote-containers.reopenInContainer",
        "title": "%commands.Reopenincontainer.title%",
        "category": "Dev Containers"
      },
      {
        "command": "remote-containers.rebuildContainer",
        "title": "%commands.Rebuildcontainer.title%",
        "category": "Dev Containers"
      },
      {
        "command": "remote-containers.rebuildContainerNoCache",
        "title": "%commands.Rebuildcontainerwithoutcache.title%",
        "category": "Dev Containers"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "remote-containers.reopenInContainer",
          "when": "!hideConnectCommands && workspaceFolderCount != 0 && !remoteName && !virtualWorkspace && isWorkspaceTrusted && !remote-containers:standingDown"
        },
        {
          "command": "remote-containers.rebuildContainer",
          "when": "!hideRebuildCommands && remoteName =~ /^dev-container$/ && !remote-containers:standingDown"
        },
        {
          "command": "remote-containers.rebuildContainerNoCache",
          "when": "!hideRebuildCommands && remoteName =~ /^dev-container$/ && !remote-containers:standingDown"
        }
      ],
      "statusBar/remoteIndicator": [
        {
          "command": "remote-containers.reopenInContainer",
          "group": "remote_30_dev-container_2_actions@8",
          "when": "!hideConnectCommands && workspaceFolderCount != 0 && !remoteName && !virtualWorkspace && isWorkspaceTrusted && !remote-containers:standingDown"
        },
        {
          "command": "remote-containers.rebuildContainer",
          "group": "remote_30_dev-container_2_actions@5",
          "when": "!hideRebuildCommands && remoteName =~ /^dev-container$/ && !remote-containers:standingDown"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "dev.containers.dockerPath": {
          "type": "string",
          "default": "docker",
          "scope": "application",
          "description": "%setting.Dockerpath.description%"
        },
        "remote.serverDownloadBaseUrl": {
          "type": "string",
          "scope": "application",
          "pattern": "^(?:[a-zA-Z][a-zA-Z0-9+.-]*://[^\\s/?#]+[^\\s]*)?$",
          "patternErrorMessage": "%setting.ServerDownloadBaseUrl.patternError%",
          "description": "%setting.ServerDownloadBaseUrl.description%"
        },
        "remote.serverDownloadFolder": {
          "type": "string",
          "scope": "application",
          "description": "%setting.ServerDownloadFolder.description%"
        },
        "dev.containers.cacheVolume": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "%setting.CacheVolume.description%"
        },
        "remote.containers.cacheVolume": {
          "scope": "application",
          "deprecationMessage": "%setting.CacheVolume.deprecationMessage%",
          "markdownDeprecationMessage": "%setting.CacheVolume.markdownDeprecationMessage%"
        },
        "dev.containers.defaultExtensions": {
          "type": "array",
          "default": [],
          "scope": "application",
          "items": {
            "type": "string",
            "pattern": "([a-z0-9A-Z][a-z0-9-A-Z]*)\\.([a-z0-9A-Z][a-z0-9-A-Z]*)",
            "errorMessage": "%setting.Defaultextensions.itemError%"
          },
          "description": "%setting.Defaultextensions.description%"
        },
        "remote.containers.defaultExtensions": {
          "scope": "application",
          "deprecationMessage": "%setting.Remotecontainersdefaultextensions.deprecation%",
          "markdownDeprecationMessage": "%setting.Remotecontainersdefaultextensions.markdownDeprecation%"
        }
      }
    }
  },
  "dependencies": {
    "@devcontainers/cli": "0.89.0",
    "jsonc-parser": "3.3.1",
    "lib-authority": "workspace:*",
    "lib-forwarding": "workspace:*",
    "lib-helper": "workspace:*",
    "lib-host": "workspace:*",
    "lib-identifiers": "workspace:*",
    "lib-log": "workspace:*",
    "lib-product": "workspace:*",
    "lib-server": "workspace:*",
    "lib-standdown": "workspace:*"
  }
}
