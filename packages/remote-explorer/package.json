{
  "name": "remote-explorer",
  "displayName": "Remote Explorer",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "remote-oss",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/remote-oss/remote.git",
    "directory": "packages/remote-explorer"
  },
  "bugs": {
    "url": "https://github.com/remote-oss/remote/issues"
  },
  "engines": {
    "vscode": "^1.139.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "keywords": [
    "remote development",
    "remote",
    "explorer"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onCommand:remote-internal.setActiveFolders"
  ],
  "enabledApiProposals": [
    "contribViewsRemote",
    "extensionsAny"
  ],
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "remote-explorer.refresh",
        "title": "%commands.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "remote-explorer.connectToRemoteInNewWindow",
        "title": "%commands.connectToRemoteInNewWindow.title%",
        "icon": "$(empty-window)"
      },
      {
        "command": "remote-explorer.connectToRemoteInCurrentWindow",
        "title": "%commands.connectToRemoteInCurrentWindow.title%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "remote-explorer.connectToFolderInNewWindow",
        "title": "%commands.connectToFolderInNewWindow.title%",
        "icon": "$(empty-window)"
      },
      {
        "command": "remote-explorer.connectToFolderInCurrentWindow",
        "title": "%commands.connectToFolderInCurrentWindow.title%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "remote-explorer.deleteFolderHistoryItem",
        "title": "%commands.deleteFolderHistoryItem.title%",
        "icon": "$(remove)"
      }
    ],
    "views": {
      "remote": [
        {
          "id": "remoteTargets",
          "name": "%views.remote.title%",
          "group": "targets@1",
          "remoteName": [
            "tunnel",
            "ssh-remote"
          ]
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "remote-explorer.refresh",
          "when": "false"
        },
        {
          "command": "remote-explorer.connectToRemoteInNewWindow",
          "when": "false"
        },
        {
          "command": "remote-explorer.connectToRemoteInCurrentWindow",
          "when": "false"
        },
        {
          "command": "remote-explorer.connectToFolderInNewWindow",
          "when": "false"
        },
        {
          "command": "remote-explorer.connectToFolderInCurrentWindow",
          "when": "false"
        },
        {
          "command": "remote-explorer.deleteFolderHistoryItem",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "remote-explorer.refresh",
          "group": "navigation",
          "when": "view == remoteTargets && !remote-explorer.standingDown"
        }
      ],
      "view/item/context": [
        {
          "command": "remote-explorer.connectToRemoteInCurrentWindow",
          "group": "inline@1",
          "when": "viewItem == remote-explorer.tunnelRemoteTarget && !remote-explorer.standingDown || viewItem == remote-explorer.sshRemoteTarget && !remote-explorer.standingDown"
        },
        {
          "command": "remote-explorer.connectToRemoteInCurrentWindow",
          "group": "navigation@1",
          "when": "viewItem == remote-explorer.tunnelRemoteTarget && !remote-explorer.standingDown || viewItem == remote-explorer.sshRemoteTarget && !remote-explorer.standingDown"
        },
        {
          "command": "remote-explorer.connectToRemoteInNewWindow",
          "group": "inline@2",
          "when": "viewItem == remote-explorer.tunnelRemoteTarget && !remote-explorer.standingDown || viewItem == remote-explorer.sshRemoteTarget && !remote-explorer.standingDown"
        },
        {
          "command": "remote-explorer.connectToRemoteInNewWindow",
          "group": "navigation@2",
          "when": "viewItem == remote-explorer.tunnelRemoteTarget && !remote-explorer.standingDown || viewItem == remote-explorer.sshRemoteTarget && !remote-explorer.standingDown"
        },
        {
          "command": "remote-explorer.connectToFolderInCurrentWindow",
          "group": "inline@1",
          "when": "viewItem == remote-explorer.remoteFolder && !remote-explorer.standingDown || viewItem == remote-explorer.tunnelWsl && !remote-explorer.standingDown"
        },
        {
          "command": "remote-explorer.connectToFolderInCurrentWindow",
          "group": "navigation@1",
          "when": "viewItem == remote-explorer.remoteFolder && !remote-explorer.standingDown || viewItem == remote-explorer.tunnelWsl && !remote-explorer.standingDown"
        },
        {
          "command": "remote-explorer.connectToFolderInNewWindow",
          "group": "inline@2",
          "when": "viewItem == remote-explorer.remoteFolder && !remote-explorer.standingDown || viewItem == remote-explorer.tunnelWsl && !remote-explorer.standingDown"
        },
        {
          "command": "remote-explorer.connectToFolderInNewWindow",
          "group": "navigation@2",
          "when": "viewItem == remote-explorer.remoteFolder && !remote-explorer.standingDown || viewItem == remote-explorer.tunnelWsl && !remote-explorer.standingDown"
        },
        {
          "command": "remote-explorer.deleteFolderHistoryItem",
          "group": "navigation@3",
          "when": "viewItem == remote-explorer.remoteFolder && !remote-explorer.standingDown"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "remote-explorer.foldersSortOrder": {
          "type": "string",
          "default": "most recently used",
          "scope": "application",
          "enum": [
            "most recently used",
            "alphabetical"
          ],
          "enumDescriptions": [
            "%settings.foldersSortOrder.mru.description%",
            "%settings.foldersSortOrder.alphabetical.description%"
          ],
          "description": "%settings.foldersSortOrder.description%"
        },
        "remote-explorer.collapseRecentFolders": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "%settings.collapseRecentFolders.description%"
        }
      }
    }
  },
  "dependencies": {
    "lib-authority": "workspace:*",
    "lib-companion": "workspace:*",
    "lib-identifiers": "workspace:*",
    "lib-product": "workspace:*",
    "lib-standdown": "workspace:*"
  }
}
