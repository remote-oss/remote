{
  "minLines": 5,
  "minTokens": 50,
  "threshold": 0,
  "exitCode": 1,
  "format": ["typescript", "javascript"],
  "ignore": [
    "**/node_modules/**",
    "**/.tsc/**",
    "**/dist/**",
    "**/dist-local/**",
    "**/dist-remote/**",
    "**/dist-reconnect/**",
    "**/dist-failure/**",
    "**/.vscode-test/**",
    "**/vscode-dts/**"
  ],
  "reporters": ["console"]
}
